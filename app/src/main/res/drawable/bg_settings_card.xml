<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware: was a hardcoded #1C1C1E, which made the card and the
     text_primary title the same shade in light mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ls_card_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/ls_card_stroke" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <include
        android:id="@+id/incToolbar"
        layout="@layout/inc_toolbar_common"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:visibility="gone"
        android:id="@+id/toolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E5E5"
        app:layout_constraintTop_toBottomOf="@id/incToolbar" />

    <androidx.core.widget.NestedScrollView
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toTopOf="@id/btnBackupNow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingTop="@dimen/_15sdp">

            <!-- Backup Location Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvBackupLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_10sdp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_grey_border_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_12sdp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="@dimen/_36sdp"
                        android:layout_height="@dimen/_36sdp"
                        android:background="@drawable/bg_rounded_light_blue">

                        <ImageView
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_folder"
                            />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/extracted_backup_location"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/_12ssp"
                            android:fontFamily="@font/geist_bold" />

                        <TextView
                            android:id="@+id/tvBackupFolderPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/extracted_backup_folder"
                            android:textColor="#666666"
                            android:textSize="@dimen/_10ssp"
                            android:fontFamily="@font/geist_regular"
                            android:layout_marginTop="@dimen/_2sdp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/ic_right_arrow"
                        app:tint="@color/icon_tint_tertiary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Restore SMS Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvRestoreSMS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_grey_border_10" />

                <LinearLayout
                    android:id="@+id/rlRestore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_12sdp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="@dimen/_36sdp"
                        android:layout_height="@dimen/_36sdp"
                        android:background="@drawable/bg_rounded_light_blue">

                        <ImageView
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_restore_backup"
                           />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/extracted_restore_sms"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/_12ssp"
                            android:fontFamily="@font/geist_bold" />

                        <TextView
                            android:id="@+id/tvRestoreStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/extracted_select_a_backup_file_to_import"
                            android:textColor="#666666"
                            android:textSize="@dimen/_10ssp"
                            android:fontFamily="@font/geist_regular"
                            android:layout_marginTop="@dimen/_2sdp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/ic_right_arrow"
                        app:tint="@color/icon_tint_tertiary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_regular"
                android:lineSpacingExtra="4dp"
                android:text="@string/extracted_currently_only_standard_text_s"
                android:textColor="#666666"
                android:textSize="@dimen/_11ssp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackupNow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:backgroundTint="@color/blue_primary"
        android:text="@string/backup_now"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/_13ssp"
        app:icon="@drawable/ic_backup"
        app:iconSize="@dimen/_20sdp"
        app:iconPadding="@dimen/_8sdp"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:cornerRadius="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


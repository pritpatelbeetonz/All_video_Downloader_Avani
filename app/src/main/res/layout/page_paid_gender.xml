<?xml version="1.0" encoding="utf-8"?>
<!-- Flow A page 1: Personalized information (gender) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_bold"
            android:text="@string/paid_onb_gender_title"
            android:textColor="@color/colorTextBlack"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/geist_regular"
            android:text="@string/paid_onb_gender_subtitle"
            android:textColor="@color/colorTextGrey"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/geist_bold"
            android:gravity="center"
            android:text="@string/paid_onb_gender_select"
            android:textColor="@color/paidOnbAccent"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/llFemale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <FrameLayout
                    android:id="@+id/flFemaleAvatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_paid_onb_circle"
                    android:backgroundTint="@color/paidOnbAvatarFemaleBg">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/paid_onb_gender_female"
                        android:src="@drawable/ic_paid_onb_avatar_female" />
                </FrameLayout>

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/paidOnbAccent"
                    android:clickable="false"
                    android:focusable="false"
                    android:fontFamily="@font/geist_medium"
                    android:text="@string/paid_onb_gender_female"
                    android:textColor="@color/colorTextBlack"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llMale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <FrameLayout
                    android:id="@+id/flMaleAvatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_paid_onb_circle"
                    android:backgroundTint="@color/paidOnbAvatarMaleBg">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/paid_onb_gender_male"
                        android:src="@drawable/ic_paid_onb_avatar_male" />
                </FrameLayout>

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/paidOnbAccent"
                    android:clickable="false"
                    android:focusable="false"
                    android:fontFamily="@font/geist_medium"
                    android:text="@string/paid_onb_gender_male"
                    android:textColor="@color/colorTextBlack"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ads: native, filled later -->
        <FrameLayout
            android:id="@+id/adNativeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

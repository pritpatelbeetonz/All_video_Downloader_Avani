<?xml version="1.0" encoding="utf-8"?>
<!-- Flow A pages 6-11: feature title, description, orange icon hero -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_bold"
            android:gravity="center"
            android:textColor="@color/colorTextBlack"
            android:textSize="22sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/geist_regular"
            android:gravity="center"
            android:textColor="@color/colorTextGrey"
            android:textSize="14sp" />

        <!-- Ads: two independent native slots, filled later (icon hero removed) -->
        <FrameLayout
            android:id="@+id/adNativeContainer"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="-20dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/adNativeContainer2"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="-20dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

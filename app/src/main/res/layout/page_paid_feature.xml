<?xml version="1.0" encoding="utf-8"?>
<!-- Flow A pages 6-11: feature title, description, orange icon hero -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_bold"
            android:gravity="center"
            android:textColor="@color/colorTextBlack"
            android:textSize="22sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/geist_regular"
            android:gravity="center"
            android:textColor="@color/colorTextGrey"
            android:textSize="14sp" />

        <!-- Icon hero: halo, ring, orange disc, white icon (on top of ad) -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_paid_onb_hero_outer" />

            <View
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_paid_onb_hero_mid" />

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_paid_onb_hero_inner"
                android:elevation="6dp">

                <ImageView
                    android:id="@+id/ivFeature"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <!-- Ads: native at bottom, filled later -->
        <FrameLayout
            android:id="@+id/adNativeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

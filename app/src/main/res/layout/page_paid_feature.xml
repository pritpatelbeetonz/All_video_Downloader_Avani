<?xml version="1.0" encoding="utf-8"?>
<!-- Flow A pages 6-11: feature title, description, illustration -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_bold"
            android:gravity="center"
            android:textColor="@color/colorTextBlack"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/geist_regular"
            android:gravity="center"
            android:textColor="@color/colorTextGrey"
            android:textSize="16sp" />

        <!-- Ads: native, filled later -->
        <FrameLayout
            android:id="@+id/adNativeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivFeature"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- One single-choice row: coloured badge circle, label, radio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_paid_onb_circle"
        android:fontFamily="@font/geist_bold"
        android:gravity="center"
        android:textColor="@color/colorWhiteCommon"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:fontFamily="@font/geist_regular"
        android:textColor="@color/colorTextBlack"
        android:textSize="20sp" />

    <RadioButton
        android:id="@+id/rbSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/paidOnbAccent"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>

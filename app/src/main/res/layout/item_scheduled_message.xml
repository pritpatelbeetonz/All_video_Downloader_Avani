<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingTop="@dimen/_15sdp">

    <!-- Message Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false">

        <!-- Grey Border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_grey_border_10" />

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_12sdp"
            android:fontFamily="@font/geist_regular"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_13ssp"
            android:lineSpacingExtra="2dp"
            tools:text="Happy Birthday! Hope you have an absolutely incredible year ahead. Let's hang out soon." />

    </androidx.cardview.widget.CardView>

    <!-- Scheduled Time Indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/_8sdp">

        <ImageView
            android:id="@+id/ivClock"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/ic_schedule"
            app:tint="#2763F7" />

        <TextView
            android:id="@+id/tvDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:fontFamily="@font/geist_medium"
            android:textColor="#2763F7"
            android:textSize="@dimen/_11ssp"
            tools:text="Sending on Dec 21st, 12:00 AM" />
    </LinearLayout>

</LinearLayout>

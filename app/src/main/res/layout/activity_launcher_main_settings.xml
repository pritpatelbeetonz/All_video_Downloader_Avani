<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/icon_tint_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== LAYOUT ==================== -->
            <TextView
                style="@style/LauncherSettingsSectionLabel"
                android:text="@string/section_layout" />

            <LinearLayout
                android:id="@+id/cardHomeScreen"
                style="@style/LauncherSettingsRow">

                <FrameLayout
                    style="@style/LauncherSettingsRowIcon"
                    android:backgroundTint="@color/ls_accent_home">

                    <ImageView
                        style="@style/LauncherSettingsRowGlyph"
                        android:src="@drawable/ic_home" />
                </FrameLayout>

                <LinearLayout style="@style/LauncherSettingsRowText">

                    <TextView
                        style="@style/LauncherSettingsRowTitle"
                        android:text="@string/title_home_screen" />

                    <TextView
                        style="@style/LauncherSettingsRowSubtitle"
                        android:text="@string/desc_home_screen" />
                </LinearLayout>

                <ImageView style="@style/LauncherSettingsRowChevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAppDrawer"
                style="@style/LauncherSettingsRow">

                <FrameLayout
                    style="@style/LauncherSettingsRowIcon"
                    android:backgroundTint="@color/ls_accent_drawer">

                    <ImageView
                        style="@style/LauncherSettingsRowGlyph"
                        android:src="@drawable/ic_apps_grid" />
                </FrameLayout>

                <LinearLayout style="@style/LauncherSettingsRowText">

                    <TextView
                        style="@style/LauncherSettingsRowTitle"
                        android:text="@string/title_app_drawer" />

                    <TextView
                        style="@style/LauncherSettingsRowSubtitle"
                        android:text="@string/desc_app_drawer" />
                </LinearLayout>

                <ImageView style="@style/LauncherSettingsRowChevron" />
            </LinearLayout>

            <!-- ==================== INTERACTION ==================== -->
            <TextView
                style="@style/LauncherSettingsSectionLabel"
                android:text="@string/section_interaction" />

            <LinearLayout
                android:id="@+id/cardSearch"
                style="@style/LauncherSettingsRow">

                <FrameLayout
                    style="@style/LauncherSettingsRowIcon"
                    android:backgroundTint="@color/ls_accent_search">

                    <ImageView
                        style="@style/LauncherSettingsRowGlyph"
                        android:src="@drawable/ic_search" />
                </FrameLayout>

                <LinearLayout style="@style/LauncherSettingsRowText">

                    <TextView
                        style="@style/LauncherSettingsRowTitle"
                        android:text="@string/title_search" />

                    <TextView
                        style="@style/LauncherSettingsRowSubtitle"
                        android:text="@string/desc_search" />
                </LinearLayout>

                <ImageView style="@style/LauncherSettingsRowChevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGestures"
                style="@style/LauncherSettingsRow">

                <FrameLayout
                    style="@style/LauncherSettingsRowIcon"
                    android:backgroundTint="@color/ls_accent_gestures">

                    <ImageView
                        style="@style/LauncherSettingsRowGlyph"
                        android:src="@drawable/ic_swipe" />
                </FrameLayout>

                <LinearLayout style="@style/LauncherSettingsRowText">

                    <TextView
                        style="@style/LauncherSettingsRowTitle"
                        android:text="@string/title_gestures" />

                    <TextView
                        style="@style/LauncherSettingsRowSubtitle"
                        android:text="@string/desc_gestures" />
                </LinearLayout>

                <ImageView style="@style/LauncherSettingsRowChevron" />
            </LinearLayout>

            <!-- ==================== SYSTEM ==================== -->
            <TextView
                style="@style/LauncherSettingsSectionLabel"
                android:text="@string/section_system" />

            <LinearLayout
                android:id="@+id/cardNavBar"
                style="@style/LauncherSettingsRow">

                <FrameLayout
                    style="@style/LauncherSettingsRowIcon"
                    android:backgroundTint="@color/ls_accent_navbar">

                    <ImageView
                        style="@style/LauncherSettingsRowGlyph"
                        android:src="@drawable/ic_navigation" />
                </FrameLayout>

                <LinearLayout style="@style/LauncherSettingsRowText">

                    <TextView
                        style="@style/LauncherSettingsRowTitle"
                        android:text="@string/title_navigation_bar" />

                    <TextView
                        style="@style/LauncherSettingsRowSubtitle"
                        android:text="@string/desc_navigation_bar" />
                </LinearLayout>

                <!-- Not clickable itself: the whole row toggles it. -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNavBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:clickable="false"
                    android:focusable="false"
                    app:thumbTint="@color/switch_thumb_selector"
                    app:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPackageMonitor"
                style="@style/LauncherSettingsRow">

                <FrameLayout
                    style="@style/LauncherSettingsRowIcon"
                    android:backgroundTint="@color/ls_accent_package">

                    <ImageView
                        style="@style/LauncherSettingsRowGlyph"
                        android:src="@drawable/ic_package" />
                </FrameLayout>

                <LinearLayout style="@style/LauncherSettingsRowText">

                    <TextView
                        style="@style/LauncherSettingsRowTitle"
                        android:text="@string/title_package_monitor" />

                    <TextView
                        style="@style/LauncherSettingsRowSubtitle"
                        android:text="@string/desc_package_monitor" />
                </LinearLayout>

                <ImageView style="@style/LauncherSettingsRowChevron" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/nativeAdCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <FrameLayout
            android:id="@+id/nativeAdShimmerFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/ads_native_big_shimmer" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nativeAdFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </androidx.cardview.widget.CardView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/_14sdp"
    android:paddingHorizontal="@dimen/_12sdp"
    android:gravity="center_vertical"
    android:background="@drawable/ripple_rounded_10">

    <FrameLayout
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginEnd="@dimen/_12sdp">
        
        <View
            android:id="@+id/viewSimIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.1"
            android:background="@drawable/circle_white" />

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sim_card"
            android:id="@+id/ivSimIcon" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSimName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/extracted_sim_1"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/geist_semibold" />

        <TextView
            android:id="@+id/tvSimCarrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/extracted_carrier_name"
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/geist_regular"
            android:layout_marginTop="@dimen/_1sdp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ivSelected"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        android:layout_marginStart="@dimen/_8sdp" />

</LinearLayout>

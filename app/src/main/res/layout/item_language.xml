    <TextView
        android:id="@+id/tvCountry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
     android:fontFamily="@font/geist_medium"        android:textColor="@color/text_primary"
        android:textSize="16sp" />

</LinearLayout>

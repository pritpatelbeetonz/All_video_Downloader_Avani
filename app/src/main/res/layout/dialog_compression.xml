<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_corner_20"
    android:backgroundTint="@color/colorDialogBg"
    android:orientation="vertical"
    android:padding="20dp">

    <RadioGroup
        android:id="@+id/radioGroupCompression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbAutomatic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_automatic"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rb100KB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_str_100kb"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rb200KB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_str_200kb"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rb300KB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_str_300kb"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rb600KB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_str_600kb"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rb1000KB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_str_1000kb"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rb2000KB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_str_2000kb"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rbNoCompression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/radio_button_tint"
            android:fontFamily="@font/geist_regular"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/extracted_no_compression"
            android:textColor="@color/colorTextBlack"
            android:textSize="@dimen/_12ssp" />

    </RadioGroup>

</LinearLayout>


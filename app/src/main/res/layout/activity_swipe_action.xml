<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <include
        android:id="@+id/incToolbar"
        layout="@layout/inc_toolbar_common" />
    <!-- RIGHT SWIPE SECTION -->
    <LinearLayout
        android:id="@+id/rightSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/incToolbar">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_semibold"
                    android:text="@string/right_swipe"
                    android:textColor="@color/colorTextBlack"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/tvSelectedRightSwipe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_regular"
                    android:text="@string/delete"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ivChangeRightSwipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_change"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableTint="@color/icon_tint_primary"
                android:fontFamily="@font/geist_medium"
                android:text="@string/change"
                android:textAllCaps="true"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <!-- Preview Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Delete Action -->
            <FrameLayout
                android:id="@+id/flRightSwipe"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent"
                android:background="@color/red">

                <ImageView
                    android:id="@+id/imgRightSwipe"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/colorWhiteCommon" />
            </FrameLayout>

            <!-- Dummy Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_12sdp">

                <View
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/circle_white"
                    android:backgroundTint="@color/colorChildBackgroundDark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:background="@color/colorChildBackgroundDark" />

                    <View
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_6sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:background="@color/colorChildBackgroundDark" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/Divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:background="@color/colorLineGrey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rightSection" />
    <!-- LEFT SWIPE SECTION -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Divider">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_semibold"
                    android:text="@string/left_swipe"
                    android:textColor="@color/colorTextBlack"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/tvSelectedLeftSwipe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_regular"
                    android:text="@string/archive"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ivChangeLeftSwipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_change"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableTint="@color/icon_tint_primary"
                android:fontFamily="@font/geist_medium"
                android:text="@string/change"
                android:textAllCaps="true"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <!-- Preview Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Dummy Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/circle_white"
                    android:backgroundTint="@color/colorChildBackgroundDark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:background="@color/colorChildBackgroundDark" />

                    <View
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_6sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:background="@color/colorChildBackgroundDark" />
                </LinearLayout>
            </LinearLayout>

            <!-- Archive Action -->
            <FrameLayout
                android:id="@+id/flLeftSwipe"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent"
                android:background="@color/colorPrimary">

                <ImageView
                    android:id="@+id/imgLeftSwipe"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_archive"
                    app:tint="@color/colorWhiteCommon" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
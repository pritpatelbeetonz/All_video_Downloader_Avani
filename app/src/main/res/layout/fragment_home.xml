<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Glass search — top (was Google bar position) -->
    <FrameLayout
        android:id="@+id/glassSearchBlur"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/search_bar_height"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="48dp"
        android:clickable="false"
        android:elevation="2dp"
        android:focusable="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/glassSearchBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_search_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/extracted_search_for_apps_or_content"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Clock Widget -->
    <TextView
        android:id="@+id/tvClock"
        style="@style/TextAppearance.CallLauncher.Clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="02:04 PM" />

    <!-- Left floating QR Logo -->
    <FrameLayout
        android:visibility="gone"
        android:id="@+id/btnQrScanner"
        android:layout_width="48dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_edge_tab"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvHomeDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#ffff"
        android:textSize="16sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvClock"
        tools:text="Wed 05 August" />

    <!-- Weather — moved off the right-hand panel to sit beside the clock, which is
         where the rest of the at-a-glance information already lives. No card: just
         icon and text, so it reads as part of the clock block rather than a widget
         floating over the wallpaper. -->
    <LinearLayout
        android:id="@+id/cardHomeWeather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/tvHomeDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvClock">

        <ImageView
            android:id="@+id/ivHomeWeatherIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_weather_sun" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHomeWeatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="28°C"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHomeWeatherCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Mostly Sunny"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Google Search — above dock -->
    <LinearLayout
        android:id="@+id/googleSearchBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="@dimen/home_search_margin_above_dock"
        android:background="@drawable/bg_google_search"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toTopOf="@id/dockContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivSearchIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="#8E8E93" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSearchText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Search here"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:padding="2dp"
            android:src="@android:drawable/ic_btn_speak_now" />

        <ImageView
            android:id="@+id/ivSettings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_launcher_settings_gear"
            app:tint="#8E8E93" />
    </LinearLayout>

    <!-- Bottom apps list — always visible on Home -->
    <!--    android:background="@drawable/bg_dock_glass"-->
    <LinearLayout
        android:id="@+id/dockContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/dock_height"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="@dimen/dock_margin_bottom"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="5"
            tools:listitem="@layout/item_dock_icon" />
    </LinearLayout>

    <!-- Non-interactive; must stay below workspace in z-order -->
    <View
        android:id="@+id/swipeUpZone"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toTopOf="@id/dockContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Workspace last so it stays above siblings and receives touches -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkspace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:focusable="true"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/googleSearchBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:itemCount="1"
        tools:listitem="@layout/item_workspace_icon" />

    <!-- Tools Folder Icon -->
    <LinearLayout
        android:id="@+id/llToolsFolder"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="24dp"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toTopOf="@id/rvWorkspace"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clipToOutline="true"
            android:background="@drawable/bg_folder_squircle"
            android:backgroundTint="#40FFFFFF">
            
            <ImageView
                android:id="@+id/ivToolsFolderIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_apps_grid"
                app:tint="@color/white" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvToolsFolderPreview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:clickable="false"
                android:focusable="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvToolsFolderAdBadge"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_gravity="bottom"
                android:background="#B3000000"
                android:text="AD"
                android:textColor="@color/white"
                android:textSize="10sp"
            android:fontFamily="@font/geist_bold"
                android:gravity="center"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tools"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


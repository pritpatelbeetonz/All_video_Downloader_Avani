<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorDialogBg"
    app:cardCornerRadius="16dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <!-- Add to contacts -->
        <TextView
            android:id="@+id/tvAddToContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/geist_regular"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/extracted_add_to_contacts"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/colorLineGrey" />

        <!-- Pin to top -->
        <TextView
            android:id="@+id/tvPinToTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/geist_regular"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/extracted_pin_to_top"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/colorLineGrey" />

        <!-- Mark unread -->
        <TextView
            android:id="@+id/tvMarkUnread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/geist_regular"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/extracted_mark_unread"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/colorLineGrey" />

        <!-- Block -->
        <TextView
            android:id="@+id/tvBlockMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/geist_regular"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/extracted_block"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/colorLineGrey" />

        <!-- Menu -->
        <TextView
            android:id="@+id/tvMenuOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/geist_regular"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/extracted_menu"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_corner_20"
    android:backgroundTint="@color/colorDialogBg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_semibold"
        android:gravity="center"
        android:paddingVertical="@dimen/_10sdp"
        android:text="@string/scheduled_message"
        android:textColor="@color/colorTextBlack"
        android:textSize="@dimen/_14ssp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/colorLineGrey" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSendNow"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_7sdp"
        android:fontFamily="@font/geist_medium"
        android:gravity="start|center_vertical"
        android:text="@string/send_now"
        android:textColor="@color/colorTextBlack"
        android:textSize="@dimen/_12ssp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCopyText"
        android:paddingVertical="@dimen/_7sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_medium"
        android:gravity="start|center_vertical"
        android:text="@string/copy_text"
        android:textColor="@color/colorTextBlack"
        android:textSize="@dimen/_12ssp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDelete"
        android:paddingVertical="@dimen/_7sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_medium"
        android:gravity="start|center_vertical"
        android:text="@string/delete"
        android:layout_marginBottom="@dimen/_5sdp"
        android:textColor="@color/colorTextBlack"
        android:textSize="@dimen/_12ssp" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popupRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/bubbleColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/arrowUp"
            android:layout_width="14dp"
            android:layout_height="7dp"
            android:layout_marginBottom="-1dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/ic_popup_arrow_up"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/menuCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_context_popup"
            android:maxWidth="150dp"
            android:minWidth="130dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowAppInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="#FF1C1C1E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:text="@string/app_info"
                    android:textColor="#FF1C1C1E"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:id="@+id/dividerAppInfo"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="8dp"
                android:background="#22000000" />

            <LinearLayout
                android:id="@+id/rowFavorite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp">

                <ImageView
                    android:id="@+id/ivFavorite"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_outline"
                    app:tint="#FF1C1C1E" />

                <TextView
                    android:id="@+id/tvFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/add_to_favorites"
                    android:textColor="#FF1C1C1E"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:id="@+id/dividerUninstall"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="8dp"
                android:background="#22000000" />

            <LinearLayout
                android:id="@+id/rowUninstall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/accent_red" />

                <TextView
                    android:id="@+id/tvUninstall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:text="@string/uninstall"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowAlreadyInstalled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="You have already install this app"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/arrowDown"
            android:layout_width="14dp"
            android:layout_height="7dp"
            android:layout_marginTop="-1dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/ic_popup_arrow_down"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

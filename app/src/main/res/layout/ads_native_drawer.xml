<?xml version="1.0" encoding="utf-8"?>
<!--
    App drawer native ad. Same structure and size as the Device Setting launcher's drawer native
    (fixed 130sdp card: video/image on the left, icon + headline, advertiser + stars, 2-line body
    and a pill CTA on the right), drawn with this app's colors and fonts.
-->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_130sdp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/admob_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ads"
        android:orientation="horizontal"
        android:padding="3dp">

        <!-- Video / image with rounded corners. AdMob requires >= 120dp x 120dp for video playback. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/media_card"
            android:layout_width="125dp"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false">

            <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="120dp"
                android:minHeight="120dp" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/_6sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingBottom="@dimen/_5sdp">

            <!-- Row 1: icon + Ad badge + headline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/ad_app_icon"
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ads_badges_drawable" />

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/geist_bold"
                    android:lines="1"
                    android:textColor="@color/text_primary"
                    android:textDirection="locale"
                    android:textSize="@dimen/_11ssp" />

            </LinearLayout>

            <!-- Row 2: advertiser + stars -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ad_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/geist_regular"
                    android:lines="1"
                    android:maxWidth="@dimen/_70sdp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_9ssp" />

                <RatingBar
                    android:id="@+id/ad_stars"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:stepSize="0.5" />
            </LinearLayout>

            <!-- Row 3: description -->
            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/geist_regular"
                android:gravity="top"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textDirection="locale"
                android:textSize="@dimen/_9ssp" />

            <!-- Row 4: pill CTA -->
            <TextView
                android:id="@+id/ad_call_to_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/round_corner_20"
                android:backgroundTint="@color/colorPrimary"
                android:fontFamily="@font/geist_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/colorTextWhite"
                android:textSize="@dimen/_12ssp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>

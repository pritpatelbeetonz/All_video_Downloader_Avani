<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:backgroundTint="@color/colorDialogBg"
    android:background="@drawable/round_corner_20">

    <RadioGroup
        android:id="@+id/radioGroupSwipeAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbNone"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/none"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>
        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbArchive"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/archive"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>
        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbDelete"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>

        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbBlock"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/block"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>

        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbCall"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>

        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbMArkRead"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mark_read"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>

        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbMarkUnread"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mark_unread"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>

        <RadioButton
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/colorTextBlack"
            android:id="@+id/rbReply"
            android:visibility="gone"
            android:layoutDirection="rtl"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reply"
            android:buttonTint="@color/radio_button_tint"
            android:paddingVertical="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"/>
    </RadioGroup>

</LinearLayout>
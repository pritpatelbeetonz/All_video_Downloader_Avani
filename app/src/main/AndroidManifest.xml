<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core & Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />


    <!-- Launcher permissions -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Video Downloader permissions (Compliant with Google Play Scoped Storage Policy) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />


    <queries>
        <!--
            The app drawer, home grid and dock are built from every app that has a
            launcher activity. Without this entry, Android 11+ package visibility
            filtering hides almost all of them from queryIntentActivities, and the
            drawer shows only the handful of apps visible through the intents below.
            MATCH_ALL does not cover this: it selects match flags, not visibility.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".MessagesApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Messages"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- The Next Gen Mobile Ads SDK (com.google.android.libraries.ads.mobile.sdk)
             takes the AdMob app id programmatically via InitializationConfig — see
             AdUnits.APP_ID / AdSdkInitializer. The legacy APPLICATION_ID meta-data
             and OPTIMIZE_* flags are not used by the Next Gen SDK. -->

        <!-- Shares camera-captured photos + recorded audio clips with the camera
             app and the MMS send path. Distinct authority from the klinker
             library's own MmsFileProvider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">


            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>



        <!-- Ported Launcher and AfterCall components -->
        <activity
            android:name="app.messages.ui.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ContactApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.messages.ui.launcher.LauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:label="@string/app_name"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.messages.ui.activity.SetDefaultLauncherActivity"
            android:exported="false" />


        <activity
            android:name=".ui.activity.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.LanguageSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activity.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.NotificationSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.SwipeActionActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.ArchiveActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.BackupRestoreActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.BlockListActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.BlockedMessagesActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.BlockedNumbersActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />



        <activity
            android:name=".ui.activity.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.activity.GroupInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp" />

        <activity
            android:name=".ui.activity.MenuActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp" />

        <activity
            android:name=".ui.activity.PermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.PremiumActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.ScheduleActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.SelectContactActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.AddPeopleActivity"
            android:exported="false"
            android:theme="@style/Theme.MessageApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.drawer.AppActionSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.LauncherMainSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.HomeScreenSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.AppDrawerSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.SearchSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.GesturesSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.PackageMonitorSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.PackageInstallScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.launcher.settings.PackageUninstallScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".search.GoogleSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1928310975548619~2515416455" />
        <meta-data
            android:name="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value="true" />

        <!-- Video Downloader Flutter Activity -->
        <activity
            android:name=".ui.videodownloader.VideoDownloaderFlutterActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:screenOrientation="fullSensor"
            android:theme="@style/adsStyle"
            tools:replace="android:theme"
            tools:ignore="DiscouragedApi" />
    </application>
</manifest>
